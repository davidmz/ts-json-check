{
  "name": "ts-json-check",
  "version": "2.0.3",
  "description": "Simple JSON-data typechecker for TypeScript",
  "keywords": [
    "typescript",
    "types",
    "typecheck",
    "validation",
    "JSON"
  ],
  "homepage": "https://github.com/davidmz/ts-json-check",
  "author": "David Mzareulyan <david@hiero.ru> (https://github.com/davidmz)",
  "license": "MIT",
  "type": "module",
  "source": "src/index.ts",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "ts-lib-build",
    "prepack": "node --test src/*.test.ts src/**/*.test.ts && ts-lib-build",
    "test": "node --test src/*.test.ts src/**/*.test.ts"
  },
  "devDependencies": {
    "@davidmz/ts-lib-build": "^0.3.2",
    "@types/node": "^25.5.2",
    "conditional-type-checks": "~1.0.6",
    "prettier": "2.5.1",
    "tslint": "~6.1.3",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "utility-types": "~3.11.0"
  }
}
