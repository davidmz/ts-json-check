{
  "name": "ts-json-check",
  "version": "2.3.0",
  "description": "Simple JSON-data typechecker for TypeScript",
  "keywords": [
    "JSON",
    "typecheck",
    "types",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/davidmz/ts-json-check",
  "license": "MIT",
  "author": "David Mzareulyan <david@hiero.ru> (https://github.com/davidmz)",
  "source": "src/index.ts",
  "type": "module",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "ts-lib-build",
    "prepack": "pnpm run check && pnpm run test && pnpm run build",
    "test": "node --test src/*.test.ts src/**/*.test.ts",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check"
  },
  "dependencies": {
    "utility-types": "~3.11.0"
  },
  "devDependencies": {
    "@davidmz/ts-lib-build": "^0.3.2",
    "@types/node": "^25.5.2",
    "conditional-type-checks": "~1.0.6",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "typescript": "^6.0.2"
  }
}
